FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY shared/ ./shared/
COPY server/ ./server/

EXPOSE 8765

ENTRYPOINT ["python", "-m", "server.game_server.main"]
CMD ["--port", "8765", "--tick-rate", "30"]
